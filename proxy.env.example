# apex-router proxy/Foundry client wiring — copy to proxy.env and fill in.
# These are NON-SECRET client env keys merged into ~/.claude/settings.json by
#   apex-router setup-proxy --config proxy.env
# The proxy's OWN auth (policy keys etc.) lives in the proxy's environment, NOT here.

# Route Claude Code through a local proxy in front of your model backend:
CLAUDE_CODE_USE_FOUNDRY=1
ANTHROPIC_FOUNDRY_BASE_URL=http://localhost:8788

# Model-id mappings your backend expects (leave unset to keep Claude Code defaults):
# ANTHROPIC_DEFAULT_OPUS_MODEL=<your-opus-id>
# ANTHROPIC_DEFAULT_SONNET_MODEL=<your-sonnet-id>
# ANTHROPIC_DEFAULT_HAIKU_MODEL=<your-haiku-id>

# Optional tuning:
# ENABLE_PROMPT_CACHING_1H=1
