#!/bin/sh
# Print an Azure access token for a resource, from a local cache when possible.
# Why: pi runs its apiKey command on EVERY request, with a 10 s limit and stderr hidden. Under load
# `az account get-access-token` can take ~10 s, so requests failed with "Failed to resolve API key".
# Rules (A1, 2026-10-26):
#  1. Cached token with > REFRESH_S left: print it. No az call.
#  2. Cached token still valid (> MIN_S left) but inside REFRESH_S: print it now, and start ONE background
#     refresh (lock holder only, output detached). The caller never waits for az.
#  3. No valid token: only the lock holder runs az. The others never run az while the lock is held: they
#     wait for the token. One absolute deadline (DEADLINE_S) bounds the whole call, az included.
# Lock: flock(2) held only by the perl process that supervises az (not inherited by az). The kernel
# drops it when that process ends, so there is no stale lock to detect or remove. az runs in its own process group with stdout to a file
# (not a pipe), and the group is killed at the deadline and after az ends (no orphan keeps the call open).
# Refresh window (2026-10-26, incident at 15:44): az (MSAL) gets a new token only when the cached one has
# less than 300 s left (msal/application.py: expires_in < 5*60). A refresh with more left returns the SAME
# token, so REFRESH_S must stay under 300. With 900 s, 17 background refreshes got the old token, and
# after an idle gap the next caller ran the slow network refresh inside its deadline and failed.
# Keep-warm: scripts/az-token-keepwarm.sh runs this every 60 s with AZ_TOKEN_MIN_S=240, so the slow
# network refresh runs there (rule 3, long deadline) and not in a pi request.
# Usage: az-token-cached [resource]
RES="${1:-https://cognitiveservices.azure.com}"
DIR="${XDG_CACHE_HOME:-$HOME/.cache}/az-token"
KEY=$(printf %s "$RES" | shasum | cut -c1-16)
TOK="$DIR/$KEY.token"; EXP="$DIR/$KEY.exp"; LOCK="$DIR/$KEY.flock"
REFRESH_S=${AZ_TOKEN_REFRESH_S:-240}   # refresh in the background when less than this is left (< 300: MSAL)
MIN_S=${AZ_TOKEN_MIN_S:-60}            # a token with less than this left is not used (keep-warm: 240)
[ "$REFRESH_S" -ge "$MIN_S" ] 2>/dev/null || REFRESH_S=$MIN_S   # rule 1 must never serve below MIN_S
DEADLINE_S=${AZ_TOKEN_DEADLINE_S:-8}   # hard limit for one call (pi's limit is 10 s)
AZ="${AZ_BIN:-az}"
umask 077
mkdir -p "$DIR"
END=$(( $(date +%s) + DEADLINE_S ))

left() { e=$(cat "$EXP" 2>/dev/null || echo 0); case "$e" in ''|*[!0-9]*) e=0 ;; esac; echo $((e - $(date +%s))); }
valid() { [ -s "$TOK" ] && [ "$(left)" -gt "$1" ]; }

# refresh <seconds> <need_s>: exit 0 = a token with > need_s left is stored (new, or by the last holder); 75 = lock held by another process; other = az failed or timed out.
# The lock is held for the whole az run and the cache write, and released only when perl exits.
refresh() {
  perl -MFcntl=:flock -MJSON::PP -e '
    my ($lock, $tok, $exp, $limit, $need, @cmd) = @ARGV;
    open(my $L, ">>", $lock) or exit 70;
    flock($L, LOCK_EX | LOCK_NB) or exit 75;
    # check again under the lock: the last holder can have stored a new token after our first check
    my $have = "";
    if (open(my $f, "<", $exp)) { local $/; $have = <$f> // "" }
    exit 0 if -s $tok && $have =~ /^\d+$/ && $have - time > $need;
    exit 124 if $limit < 1;
    # The lock fd closes on exec: only this supervisor holds the lock, never az or a child of az.
    # So no detached process can hold the lock forever ("never block" wins over "never two az").
    # Known risk: if this supervisor is killed from outside, an orphaned az can overlap one new az.
    (my $dir = $tok) =~ s{/[^/]*$}{}; (my $base = $tok) =~ s{^.*/}{};
    if (opendir(my $D, $dir)) {               # outputs of killed supervisors (literal names, no glob)
      unlink map { "$dir/$_" } grep { index($_, "$base.out.") == 0 && -M "$dir/$_" > 1/1440 } readdir $D;
      closedir $D }
    my $out = "$tok.out.$$";
    my $p = fork; exit 71 unless defined $p;
    if (!$p) { setpgrp(0, 0); open(STDOUT, ">", $out); open(STDERR, ">", "/dev/null"); open(STDIN, "<", "/dev/null");
               exec @cmd; exit 127 }
    my $rc;
    eval { local $SIG{ALRM} = sub { die "t\n" }; alarm $limit; waitpid($p, 0); $rc = $? >> 8; alarm 0 };
    kill "KILL", -$p;                       # the whole group: at the deadline, and any child left after az
    if ($@) { waitpid($p, 0); unlink $out; exit 124 }
    my $j = eval { local $/; open(my $f, "<", $out) or die; decode_json(<$f>) };
    unlink $out;
    exit 1 if $rc || !$j;
    my ($t, $e) = ($j->{accessToken}, $j->{expires_on});
    exit 1 unless defined $t && length $t && defined $e && $e =~ /^\d+$/;
    for ([$tok, $t], [$exp, $e]) { my ($f, $v) = @$_; open(my $o, ">", "$f.tmp.$$") or exit 1; print $o $v;
                                   close $o or exit 1; rename("$f.tmp.$$", $f) or exit 1 }
    exit($e - time > $need ? 0 : 1)  # stored, but az returned a token with too little life (MSAL < 300 s rule)
  ' "$LOCK" "$TOK" "$EXP" "$1" "$2" "$AZ" account get-access-token --resource "$RES" -o json
}

# 1. fresh
if valid "$REFRESH_S"; then cat "$TOK"; exit 0; fi

# 2. still valid: answer now, refresh in the background (only one process gets the lock)
if valid "$MIN_S"; then
  ( refresh "$DEADLINE_S" "$REFRESH_S" ) </dev/null >/dev/null 2>&1 &
  cat "$TOK"; exit 0
fi

# 3. no valid token: run az if the lock is free, else wait for the holder's token. One deadline for all.
while :; do
  now=$(date +%s)
  [ "$now" -lt "$END" ] || exit 1
  refresh $(( END - now )) "$MIN_S"; rc=$?
  if [ $rc = 0 ]; then cat "$TOK"; exit 0; fi
  [ $rc = 75 ] || exit 1                 # we ran az and it failed: do not retry inside the deadline
  sleep 0.25
  if valid "$MIN_S"; then cat "$TOK"; exit 0; fi
done
