proxy.env

# runtime / machine-local state generated by install.sh or the router at runtime
# (serve-ornith.sh, ornith.env and tables/route_table.*.json are WRITTEN by install.sh;
#  logs/ and queue/ are live service state; offload_daily.md is an appended daily report)
logs/
queue/
ornith.env
serve-ornith.sh
offload_daily.md
tables/
