.venv/
.venv-*/
__pycache__/
*.pyc
.pytest_cache/
dist/
build/
*.egg-info/
.DS_Store
# uv's project lockfile — apex-router installs via `uv pip install -e` (pip-compatible),
# not `uv sync`/`uv lock`, so nothing here consumes a lockfile. Ignore the stray artifact.
uv.lock

# --- secrets / never publish ---
.env
.env.*
*.pem
*.key
*_rsa
*_ed25519
secrets/
**/secrets/**
credentials*
*.credentials
# real captured corpus / route tables can contain production data — keep local
# (tables/ itself is ignored below; route_table.*.json are generated by install.sh)
corpus/
*.jsonl


# tool-local config (not part of the package)
.serena/
proxy.env

# runtime / machine-local state generated by install.sh or the router at runtime
# (serve-ornith.sh, ornith.env and tables/route_table.*.json are WRITTEN by install.sh;
#  logs/ and queue/ are live service state; offload_daily.md is an appended daily report)
logs/
queue/
ornith.env
serve-ornith.sh
offload_daily.md
tables/

# machine-local apex-route family overrides (personal model choices)
pi-routes.json

# machine-local runtime state (never commit — public repo)
models.json
handoff_threshold.json
memory_index.db
judge_probe_baseline.json
memory_dirs.txt
